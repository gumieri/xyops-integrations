      "id": "testplug",
      "kill": "parent",
      "modified": 1786648277,
      "notes": "The Test Plugin exists mainly to test xyOps, but it can also be useful for testing pieces of workflows.  It outputs sample data and optionally a sample file, which are passed to downstream events, if connected.  It can also simulate various job outcomes (success, fail, etc.).",
      "params": [
        {
          "id": "duration",
          "required": true,
          "title": "Test Duration (seconds)",
          "type": "text",
          "value": 60,
          "variant": "number"
        },
        {
          "id": "action",
          "title": "Simulate Result",
          "type": "select",
          "value": "Success, Error, Warning, Critical, Crash"
        },
        {
          "id": "custom",
          "title": "Custom Value",
          "type": "text",
          "value": ""
        },
        {
          "id": "burn",
          "title": "Burn Memory/CPU",
          "type": "checkbox",
          "value": false
        },
        {
          "id": "network",
          "title": "Generate Network Traffic",
          "type": "checkbox",
          "value": false
        },
        {
          "id": "upload",
          "title": "Upload Sample File",
          "type": "checkbox",
          "value": false
        }
      ],
      "revision": 1,
      "stock": true,
      "title": "Test Plugin",
      "type": "event",
      "username": "admin"
    },
    {
