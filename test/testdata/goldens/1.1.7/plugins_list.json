    {
      "command": "[docker-plugin]",
      "created": 1786648277,
      "enabled": true,
      "icon": "docker",
      "id": "dockerplug",
      "kill": "all",
      "modified": 1786648277,
      "notes": "Use this Plugin to run custom scripts inside a Docker container.",
      "params": [
        {
          "caption": "Enter the name of the Docker image to use, which can be local or remote.",
          "id": "image_name",
          "locked": true,
          "required": true,
          "title": "Image Name",
          "type": "text",
          "value": "ghcr.io/pixlcore/xyops-shell-image",
          "variant": "text"
        },
        {
          "caption": "Enter the desired version of the image to use, or use \"latest\" for the latest version.",
          "id": "image_ver",
          "locked": true,
          "required": true,
          "title": "Image Version",
          "type": "text",
          "value": "latest",
          "variant": "text"
        },
        {
          "caption": "Enter the desired name of the Docker container, which can contain placeholder macros from the job data.",
          "id": "cont_name",
          "locked": false,
          "required": true,
          "title": "Container Name",
          "type": "text",
          "value": "xyops-job-{{id}}",
          "variant": "text"
        },
        {
          "caption": "Set the maximum number of CPU cores the container is allowed to use, or 0 for unlimited.",
          "id": "cont_cpus",
          "locked": false,
          "required": false,
          "title": "Max CPUs",
          "type": "text",
          "value": 1,
          "variant": "number"
        },
        {
          "caption": "Enter the maximum amount of memory to allow the container to use, or leave blank for unlimited.",
          "id": "cont_mem",
          "locked": false,
          "required": false,
          "title": "Max Memory",
          "type": "text",
          "value": "1 GB",
          "variant": "text"
        },
        {
          "caption": "Optionally specify a Docker network name for the container to join.",
          "id": "cont_net",
          "locked": false,
          "required": false,
          "title": "Join Network",
          "type": "text",
          "value": "",
          "variant": "text"
        },
        {
          "caption": "Optionally add any extra command-line arguments to pass to `docker run` (for e.g. volume mounts).",
          "id": "cont_extras",
          "locked": true,
          "required": false,
          "title": "Command Extras",
          "type": "text",
          "value": "",
          "variant": "text"
        },
        {
          "caption": "Enter the initial command to run as the container starts.  It is recommended to use [xyrun](https://github.com/pixlcore/xyrun) for this, so resources are monitored, and files are managed properly.\n",
          "id": "cont_cmd",
          "locked": true,
          "required": false,
          "title": "Launch Command",
          "type": "text",
          "value": "xyrun",
          "variant": "text"
        },
        {
          "caption": "Choose whether you want the entire job JSON data to be sent to STDIN, or only the script source (advanced).",
          "id": "run_mode",
          "locked": false,
          "title": "Run Mode",
          "type": "select",
          "value": "Send Job JSON, Send Script Source"
        },
        {
          "caption": "Enter the code to run inside the container.  You can use any language that supports a shebang line.",
          "id": "script",
          "locked": true,
          "required": true,
          "title": "Script Source",
          "type": "code",
          "value": "#!/bin/sh\n\n# Enter your shell script code here"
        },
        {
          "caption": "Run an \"init\" inside the container that forwards signals and reaps processes.",
          "id": "cont_init",
          "locked": false,
          "title": "Init process manager",
          "type": "checkbox",
          "value": true
        },
        {
          "caption": "Automatically delete the container after the job completes (recommended).",
          "id": "cont_rm",
          "locked": false,
          "title": "Ephemeral Container",
          "type": "checkbox",
          "value": true
        },
        {
          "caption": "Enable verbose debug logging (raw docker command, etc.).",
          "id": "verbose",
          "locked": false,
          "title": "Verbose Logging",
          "type": "checkbox",
          "value": false
        }
      ],
      "revision": 1,
      "runner": true,
      "stock": true,
      "title": "Docker Run",
      "type": "event",
      "username": "admin"
    },
